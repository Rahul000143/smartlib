# Smart Library Management System Environment Configuration
SECRET_KEY=smart-library-production-key-change-me

# MongoDB Database Configuration
# Local MongoDB instance:
MONGO_URI=mongodb://localhost:27017/smart_library
# Or MongoDB Atlas Cloud:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_library?retryWrites=true&w=majority
MONGO_DBNAME=smart_library

# Neo4j Graph Database Configuration
# Local Neo4j instance:
NEO4J_URI=bolt://localhost:7687
# Or Neo4j Aura Cloud:
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=library123

# Library Policy Configuration
STUDENT_LOAN_DAYS=14
STAFF_LOAN_DAYS=30
FINE_PER_DAY=1.0

# Port
PORT=5000
